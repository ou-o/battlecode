.battle { position: relative; width: 100vw; height: 100vh; overflow: hidden; }
.cam-wrap { position: absolute; inset: 0; }
.camera { width: 100%; height: 100%; }
.overlay { position: absolute; left: 0; top: 0; width: 100vw; height: 100vh; pointer-events: none; }

.hud-top { position: absolute; left: 20rpx; right: 20rpx; top: 20rpx; padding: 16rpx; border-radius: 16rpx; }
.me-row { display: flex; align-items: center; gap: 12rpx; font-size: 22rpx; }
.me-name { font-size: 28rpx; font-weight: 600; color: #dfe4ee; }
.me-meta { color: #9aa6bd; }
.fps { margin-left: auto; color: #6bd96b; }

.bar { height: 24rpx; background: #0f1117; border-radius: 12rpx; overflow: hidden; position: relative; margin-top: 8rpx; }
.bar .fill { height: 100%; }
.bar .fill.red { background: linear-gradient(90deg, #b4373b, #ff6b6b); }
.bar .fill.blue { background: linear-gradient(90deg, #2d6cf5, #4d9bff); }
.bar > text { position: absolute; left: 12rpx; top: 0; line-height: 24rpx; font-size: 18rpx; color: #fff; }
.hpbar { height: 32rpx; }

/* 友方侧栏（敌方无侧栏：敌方信息仅扫描时出现在画面名牌上） */
.side { position: absolute; top: 200rpx; width: 280rpx; background: rgba(12,14,20,0.7); border-radius: 12rpx; padding: 12rpx; }
.side.friends { left: 20rpx; border-left: 6rpx solid #4d9bff; }
.side-title { color: #9aa6bd; font-size: 22rpx; margin-bottom: 8rpx; }
.side-row { display: flex; flex-direction: column; padding: 6rpx 0; }
.sr-n { font-size: 20rpx; color: #dfe4ee; }
.side-row .bar { margin-top: 4rpx; }

/* 基地面板：常显己方基地 */
.bases { position: absolute; bottom: 200rpx; left: 20rpx; right: 20rpx; display: flex; gap: 16rpx; }
.base { flex: 1; background: rgba(12,14,20,0.7); padding: 12rpx; border-radius: 12rpx; font-size: 22rpx; }
.base.red-base { border-left: 6rpx solid #ff6b6b; }
.base.blue-base { border-left: 6rpx solid #4d9bff; }
.base text { color: #dfe4ee; display: block; margin-bottom: 6rpx; }

/* shutter button — camera-app style, circular white, bottom center */
.shutter-wrap { position: absolute; bottom: 20rpx; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.shutter-btn { position: relative; width: 160rpx; height: 160rpx; padding: 0; margin: 0; background: transparent !important; border: none; line-height: normal; border-radius: 50%; }
.shutter-btn::after { border: none; }
.shutter-ring { position: absolute; inset: 0; border: 8rpx solid rgba(255,255,255,0.92); border-radius: 50%; box-sizing: border-box; }
.shutter-core { position: absolute; inset: 22rpx; background: #ffffff; border-radius: 50%; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.45); transition: transform 80ms; }
.shutter-btn:active .shutter-core { transform: scale(0.86); }
.shutter-btn.disabled .shutter-ring { border-color: rgba(255,255,255,0.35); }
.shutter-btn.disabled .shutter-core { background: #cfd3da; }
.shutter-label { font-size: 24rpx; color: #dfe4ee; text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.8); }

/* 受击反馈：全屏红色 vignette，450ms 淡出 */
.hurt-vignette { position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 120rpx 40rpx rgba(255,45,45,0.55); animation: hurtFade 450ms ease-out forwards; }
@keyframes hurtFade { from { opacity: 1; } to { opacity: 0; } }

/* 横幅：守望先锋风格入场（击杀金色 / 阵亡红 / 掩体金 / 复活绿） */
.banner { position: absolute; left: 50%; top: 40%; transform: translate(-50%, -50%); font-size: 72rpx; font-weight: 700; padding: 20rpx 56rpx; border-radius: 16rpx; pointer-events: none; animation: bannerIn 260ms ease-out; }
.banner.kill { background: linear-gradient(100deg, rgba(0,0,0,0.15), rgba(0,0,0,0.62) 22%, rgba(0,0,0,0.62) 78%, rgba(0,0,0,0.15)); color: #ffd56b; text-shadow: 0 0 24rpx rgba(255,213,107,0.45); }
.banner.down { background: rgba(0,0,0,0.55); color: #ff6b6b; }
.banner.bunker { background: rgba(0,0,0,0.55); color: #e0b84d; }
.banner.revive { background: rgba(0,0,0,0.55); color: #6bd96b; }
@keyframes bannerIn {
  0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0; }
  60% { transform: translate(-50%, -50%) scale(1.08); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
}

.loading-hint { position: absolute; left: 50%; top: 80rpx; transform: translateX(-50%); background: rgba(0,0,0,0.6); color: #4d9bff; padding: 8rpx 24rpx; border-radius: 8rpx; font-size: 24rpx; }

.dead-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; }
.dead-inner { text-align: center; color: #ff6b6b; }
.dead-title { font-size: 64rpx; font-weight: 700; }
.dead-sub { font-size: 28rpx; color: #dfe4ee; margin-top: 16rpx; }
.dead-counter { font-size: 80rpx; font-weight: 700; color: #ffd56b; margin-top: 24rpx; }
/* 扫描态：减淡蒙层露出摄像头与基地识别框，面板沉底不挡中央瞄准区 */
.dead-overlay.scan { background: rgba(0,0,0,0.35); align-items: flex-end; padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }
.dead-overlay.scan .dead-inner { background: rgba(12,14,20,0.72); border-radius: 16rpx; padding: 28rpx 40rpx; }
.scan-progress { width: 360rpx; height: 12rpx; background: rgba(255,255,255,0.18); border-radius: 6rpx; overflow: hidden; margin: 24rpx auto 0; }
.scan-fill { height: 100%; background: #6bd96b; border-radius: 6rpx; transition: width 0.2s linear; }
.scan-label { font-size: 26rpx; color: #dfe4ee; margin-top: 16rpx; }

.end-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; }
.end-inner { text-align: center; }
.end-title { font-size: 80rpx; font-weight: 700; color: #ffd56b; margin-bottom: 32rpx; }
