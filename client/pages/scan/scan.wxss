.scan { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #000; }
.cam-wrap { position: absolute; inset: 0; }
.camera { width: 100%; height: 100%; }
.overlay { position: absolute; inset: 0; pointer-events: none; }

.hud-top { position: absolute; left: 20rpx; right: 20rpx; top: 20rpx; padding: 16rpx; border-radius: 16rpx; }
.me-row { display: flex; align-items: center; gap: 12rpx; font-size: 22rpx; }
.me-name { font-size: 28rpx; font-weight: 600; color: #dfe4ee; }
.me-meta { color: #00ff88; font-weight: 600; }
.fps { margin-left: auto; color: #6bd96b; }

.tagstrip { position: absolute; top: 130rpx; left: 20rpx; right: 20rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.tagstrip.hint { color: #9aa6bd; }
.hint-text { font-size: 26rpx; }
.tag-chip { background: rgba(0,255,136,0.16); color: #00ff88; border: 2rpx solid #00ff88; padding: 6rpx 18rpx; border-radius: 8rpx; font-size: 26rpx; font-weight: 600; }

.footer { position: absolute; bottom: 20rpx; left: 20rpx; right: 20rpx; display: flex; gap: 16rpx; }
.toggle-btn { flex: 1; background: #2a3142; color: #dfe4ee; border-radius: 16rpx; height: 96rpx; font-size: 28rpx; }
.back-btn { flex: 1; background: #b4373b; color: white; border-radius: 16rpx; height: 96rpx; font-size: 28rpx; }

.loading-hint { position: absolute; left: 50%; top: 200rpx; transform: translateX(-50%); background: rgba(0,0,0,0.6); color: #4d9bff; padding: 8rpx 24rpx; border-radius: 8rpx; font-size: 24rpx; }