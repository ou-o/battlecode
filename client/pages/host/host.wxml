<view class="page">
  <view wx:if="{{!created}}" class="setup">
    <view class="bc-title">房主建房</view>
    <view class="bc-muted">建房后请在浏览器打开控制台录入掩体并开始游戏。房主本人不参与对战。</view>
    <view class="bc-row">
      <label>房主昵称
        <input class="bc-input" data-k="hostName" bindinput="onInput" value="{{hostName}}" placeholder="你的昵称" />
      </label>
    </view>
    <view class="bc-row">
      <label>自选房间号（三位数字，留空随机）
        <input class="bc-input" data-k="codeHint" type="number" bindinput="onInput" value="{{codeHint}}" placeholder="如 365" maxlength="3" />
      </label>
    </view>
    <view class="bc-err" wx:if="{{err}}">{{err}}</view>
    <button class="bc-btn" bindtap="createRoom">创建房间</button>
  </view>

  <view wx:if="{{created}}" class="panel">
    <view class="bc-title">房间 {{code}}</view>
    <view class="bc-muted">请通知玩家用小程序输入房间号 {{code}} 加入。</view>

    <view class="bc-card">
      <view class="sec-title">hostToken</view>
      <view class="token-row">
        <text class="token">{{hostToken}}</text>
        <button class="bc-btn small" bindtap="copyToken">复制 token</button>
      </view>
    </view>

    <view class="bc-card">
      <view class="sec-title">控制台地址</view>
      <view class="bc-muted">在电脑浏览器打开以下地址管理房间（录入掩体 / 开始 / 关闭）：</view>
      <button class="bc-btn" bindtap="copyConsoleUrl">复制控制台 URL</button>
    </view>

    <view class="bc-err" wx:if="{{err}}">{{err}}</view>
  </view>
</view>