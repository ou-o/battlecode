.page { padding: 24rpx; }
.bc-title { font-size: 44rpx; font-weight: 700; margin: 24rpx 0; }
.bc-muted { color: #7d8696; font-size: 26rpx; margin: 12rpx 0; }
.bc-card { background: #181c26; padding: 24rpx; border-radius: 12rpx; margin: 18rpx 0; }
.sec-title { font-size: 26rpx; color: #9aa6bd; margin-bottom: 16rpx; }
.token-row { display: flex; align-items: flex-start; gap: 12rpx; }
.token { font-family: ui-monospace, Menlo, monospace; font-size: 22rpx; word-break: break-all; flex: 1; background: #0c0e14; padding: 12rpx; border-radius: 8rpx; }
.bc-btn.small { width: auto; padding: 10rpx 20rpx; font-size: 22rpx; margin: 0; }